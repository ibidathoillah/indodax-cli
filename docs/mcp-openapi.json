{
  "openapi": "3.1.0",
  "info": {
    "title": "Indodax MCP Isolated Bridge",
    "description": "Secure bridge for Indodax exchange operations via MCP tools.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://YOUR-CODESPACE-OR-SERVER-URL"
    }
  ],
  "paths": {
    "/call/ticker": {
      "post": {
        "operationId": "getTicker",
        "summary": "Get current price and 24h stats for a pair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pair": { "type": "string", "default": "btc_idr", "description": "Trading pair, e.g., btc_idr" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/call/balance": {
      "post": {
        "operationId": "getBalance",
        "summary": "Get non-zero account balances",
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/call/buy_order": {
      "post": {
        "operationId": "placeBuyOrder",
        "summary": "Place a buy order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pair": { "type": "string" },
                  "idr": { "type": "number", "description": "Amount in IDR to spend" },
                  "price": { "type": "number", "description": "Price per coin (omit for market order)" }
                },
                "required": ["pair", "idr"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/call/sell_order": {
      "post": {
        "operationId": "placeSellOrder",
        "summary": "Place a sell order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pair": { "type": "string" },
                  "amount": { "type": "number", "description": "Amount of crypto to sell" },
                  "price": { "type": "number", "description": "Price per coin (omit for market order)" },
                  "order_type": { "type": "string", "enum": ["limit", "market"], "default": "limit" }
                },
                "required": ["pair", "amount"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/call/paper_init": {
      "post": {
        "operationId": "initPaper",
        "summary": "Initialize a risk-free paper trading account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idr": { "type": "number", "default": 100000000 },
                  "btc": { "type": "number", "default": 1 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Success" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": { "type": "apiKey", "in": "header", "name": "x-api-key" },
      "ApiSecret": { "type": "apiKey", "in": "header", "name": "x-api-secret" }
    }
  },
  "security": [ { "ApiKey": [], "ApiSecret": [] } ]
}
